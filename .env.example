# Google Cloud → API 和服务 → 凭据
# OAuth 2.0 客户端 ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key — for unauthenticated public data calls (Path A)
YOUTUBE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OAuth redirect origin. For local dev this is http://localhost:5173.
# Must EXACTLY match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_ORIGIN=http://localhost:5173
